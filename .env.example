# Add values from your Supabase project when one is created.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required for endpoint heartbeat writes and device enrollment (server-side only; never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Optional transactional email (all values are server-side; never prefix these with NEXT_PUBLIC_)
RESEND_API_KEY=
EMAIL_FROM=
HELPDESK_NOTIFICATION_EMAIL=
APP_BASE_URL=http://localhost:3000
